    "Finn ut hvor mye garn du trenger når du bytter til et annet med forskjellig løpelengde. Husk at strikkefastheten skal være lik.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Find ud af hvor meget garn du skal bruge når du skifter til et andet med forskellig løbelængde. Husk at strikkefastheden skal være den samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finden Sie heraus, wie viel Garn Sie benötigen, wenn Sie zu einem anderen mit unterschiedlicher Lauflänge wechseln. Beachten Sie, dass die Maschenprobe gleich sein sollte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find out how much yarn you need when substituting to another with different yardage. Remember that the gauge should be the same."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Selvitä kuinka paljon lankaa tarvitset vaihtaessasi toiseen lankaan, jolla on eri juoksupituus. Muista, että neuletiheyden tulee olla sama."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvrez combien de fil vous avez besoin lorsque vous substituez à un autre avec un métrage différent. N'oubliez pas que l'échantillon doit être le même."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta reda på hur mycket garn du behöver när du byter till ett annat med olika löplängd. Kom ihåg att sticktätheten ska vara densamma."
          }
        }
      }
    },
