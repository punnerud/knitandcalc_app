    },
    "Er du sikker på at du vil fjerne dette garnet?": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil fjerne dette garn?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie dieses Garn wirklich entfernen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to remove this yarn?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko varmasti poistaa tämän langan?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr de vouloir retirer ce fil?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill ta bort detta garn?"
          }
        }
      }
    },
    "Er du sikker på at du vil koble fra dette garnet fra \"%@\"? Prosjektet vil også miste garnet i sin oversikt.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil fjerne dette garn fra \"%@\"? Projektet vil også miste garnet i sin oversigt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie dieses Garn wirklich von \"%@\" trennen? Das Projekt verliert das Garn ebenfalls in seiner Übersicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to unlink this yarn from \"%@\"? The project will also lose the yarn in its overview."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to unlink this lanka from \"%@\"? The project will also lose the lanka in its overview."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to unlink this fil from \"%@\"? The project will also lose the fil in its overview."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill ta bort detta garn från \"%@\"? Projektet kommer också att förlora garnet i sin översikt."
          }
        }
      }
    },
    "Er du sikker på at du vil slette \"%@ %@\"?": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil slette \"%1$@ %2$@\"?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie \"%1$@ %2$@\" wirklich löschen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Er du sikker på at du vil slette \"%1$@ %2$@\"?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko varmasti poistaa \"%1$@ %2$@\"?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr de vouloir supprimer \"%1$@ %2$@\"?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill radera \"%1$@ %2$@\"?"
          }
        }
      }
    },
    "Er du sikker på at du vil slette \"%@ %@\"?\n\nTips: Du kan også trekke til venstre på oversikten for å redigere eller slette. Det er raskere enn å bruke denne knappen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Er du sikker på at du vil slette \"%1$@ %2$@\"?\n\nTips: Du kan også trekke til venstre på oversikten for å redigere eller slette. Det er raskere enn å bruke denne knappen."
          }
        }
      }
    },
    "Er du sikker på at du vil slette \"%@\"?": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil slette \"%@\"?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie „%@\" wirklich löschen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete \"%@\"?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko varmasti poistaa \"%@\"?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr de vouloir supprimer « %@ » ?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill radera \"%@\"?"
          }
        }
      }
    },
    "Er du sikker på at du vil slette \"%@\"?\n\nTips: Du kan også trekke til venstre på oversikten for å redigere eller slette. Det er raskere enn å bruke denne knappen.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil slette \"%@\"?\n\nTip: Du kan også swipe til venstre på oversigten for at redigere eller slette. Det er hurtigere end at bruge denne knap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie „%@\" wirklich löschen?\n\nTipp: Sie können auch in der Übersicht nach links wischen, um zu bearbeiten oder zu löschen. Das geht schneller als diese Schaltfläche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete \"%@\"?\n\nTip: You can also swipe left on the list to edit or delete. It's faster than using this button."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko varmasti poistaa \"%@\"?\n\nVinkki: Voit myös pyyhkäistä vasemmalle listassa muokataksesi tai poistaaksesi. Se on nopeampaa kuin tämän painikkeen käyttö."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr de vouloir supprimer « %@ » ?\n\nAstuce : Vous pouvez aussi glisser vers la gauche dans la liste pour modifier ou supprimer. C'est plus rapide qu'utiliser ce bouton."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill radera \"%@\"?\n\nTips: Du kan också svepa åt vänster i listan för att redigera eller radera. Det är snabbare än att använda den här knappen."
          }
        }
      }
    },
    "Er du sikker på at du vil slette alle markeringer på alle sider?": {
      "localizations": {
        "da": {
          "stringUnit": {
