    "Er du sikker på at du vil fjerne \"%@ %@\"?": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil fjerne \"%1$@ %2$@\"?"
          }
