    "Kan ikke felle. Kan ikke felle med mer enn %lld når du har %lld masker på pinnen": {
      "extractionState": "stale",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke falde. Kan ikke falde med mere end %1$lld når du har %2$lld masker på pinden"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann nicht abnehmen. Sie können nicht mehr als %1$lld Maschen abnehmen, wenn Sie %2$lld Maschen auf der Nadel haben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot decrease. Cannot decrease by more than %1$lld when you have %2$lld stitches on needle"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot vähennä. Cannot vähennä by more than %1$lld when you have %2$lld silmukkaes on puikko"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot diminuer. Cannot diminuer by more than %1$lld when you have %2$lld maillees on aiguille"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan inte minska. Kan inte minska med mer än %1$lld när du har %2$lld maskor på stickan"
          }
        }
      }
    },
