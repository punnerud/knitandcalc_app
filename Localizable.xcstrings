    "Dette vil nullstille all synkroniseringsstatistikk og la deg teste synkronisering på nytt.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil nulstille al synkroniseringsstatistik og lade dig teste synkronisering igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies setzt alle Synchronisierungsstatistiken zurück und lässt Sie die Synchronisierung erneut testen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will reset all sync statistics and let you test sync again."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä nollaa kaikki synkronointitilastot ja antaa sinun testata synkronointia uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela réinitialisera toutes les statistiques de synchronisation et vous permettra de tester à nouveau."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta nollställer all synkroniseringsstatistik och låter dig testa synkronisering igen."
