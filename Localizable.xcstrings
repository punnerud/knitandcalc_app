    "settings.info.description": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter at have ændret sprog, skal du lukke og genåbne appen for at ændringerne træder i kraft."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Ändern der Sprache schließen und öffnen Sie bitte die App erneut, damit die Änderungen wirksam werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After changing the language, please close and reopen the app for the changes to take effect."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "After changing the language, please close and reopen the app for the changes to take effect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "After changing the language, please close and reopen the app for the changes to take effect."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etter å ha endret språk, vennligst lukk og åpne appen igjen for at endringene skal tre i kraft."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter att ha ändrat språk, vänligen stäng och öppna appen igen för att ändringarna ska träda i kraft."
          }
        }
      }
    },
